trying to set up nvidia container:

## ONE TIME SETUP
# make a persistent place for conda *as seen from inside the container*
module load apptainer 
mkdir -p /blue/zhou/jason.liang/containers/conda_in_container
apptainer exec --nv \
  --bind /blue/zhou/jason.liang/containers/conda_in_container:/opt/conda \
  --bind /blue/zhou/jason.liang:/blue/zhou/jason.liang \
  --bind /orange/zhou:/orange/zhou \
  docker://nvcr.io/nvidia/tensorflow:25.01-tf2-py3 \
  bash -lc '
    # install miniconda only once
    if [ ! -x /opt/conda/bin/conda ]; then
      wget -qO /tmp/miniconda.sh https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-x86_64.sh
      bash /tmp/miniconda.sh -b -p /opt/conda
    fi
    # create your env (adjust packages as needed)
    /opt/conda/bin/conda create -y -n nvidia-rcl-env python=3.12.11 pandas numpy scikit-learn transformers
    # quick TensorFlow check using container TF
    /opt/conda/envs/nvidia-rcl-env/bin/python - <<PY
import tensorflow as tf
print("TensorFlow version:", tf.__version__)
print("GPUs:", tf.config.list_physical_devices("GPU"))
PY
  '